---
// Retired 2026-11-05. The ASN lookup moved to lookup.prodipdata.com, which answers one /24 or one ASN per
// request; this page used to download whole monthly data shards from the public prefix-data repo
// (via jsDelivr). It now only forwards, keeping the query string (?q= / ?asn= have the same names
// there), so old links and bookmarks land on the same answer.
const target = 'https://lookup.prodipdata.com/asn-lookup';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASN Lookup has moved | ProdIPData</title>
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style is:inline>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#070d1c;color:#c9d4ec;font:16px/1.6 system-ui,sans-serif}a{color:#2dd4bf}</style>
  </head>
  <body>
    <p>ASN Lookup has moved to <a href={target}>lookup.prodipdata.com/asn-lookup</a>.</p>
  </body>
</html>
