---
import BaseLayout from '../layouts/BaseLayout.astro';
import releases from '../../assets/data/releases.json';

// Current release drives which monthly shard set we read.
const release = releases.current_release;

// Per-1,000-ASN JSON shards live in the prefix-data repo next to the Prefix Lookup shards, served via
// jsDelivr. One shard (AS15169 -> asn/<month>/15.json) is fetched per lookup.
const dataBase = 'https://cdn.jsdelivr.net/gh/ProdIPData/prefix-data@main';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prodipdata.com/' },
    { '@type': 'ListItem', position: 2, name: 'ASN lookup', item: 'https://prodipdata.com/asn-lookup.html' },
  ],
};
---
<BaseLayout
  title="ASN Lookup — Autonomous System Details, Prefixes & Footprint | ProdIPData"
  description="Look up any autonomous system number and see its name, organisation, registry record, routed IPv4 footprint, where its /24s geolocate, RPKI status, risk signals and its prefixes — from the monthly ProdIPData release, in your browser."
  ogTitle="ASN Lookup"
  canonicalPath="/asn-lookup.html"
  page="asn-lookup"
  navPage="prefix-lookup"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

  <main class="container lookup">
    <section class="lookup-hero">
      <h1>ASN lookup</h1>
      <p class="lookup-sub">
        Enter an autonomous system number to see its published attributes for the <strong>{release}</strong> release:
        name, organisation, registry record, routed IPv4 footprint, where its <code>/24</code> blocks geolocate,
        routing security, risk signals and its prefixes. Everything is read directly from the monthly data in your
        browser; nothing is sent to a server. To look up an address instead, use the
        <a href="prefix-lookup.html">Prefix lookup</a>.
      </p>

      <form id="asnForm" class="lookup-form glass" autocomplete="off">
        <input
          id="asnInput"
          class="lookup-input"
          type="text"
          inputmode="numeric"
          placeholder="e.g. 15169  or  AS13335"
          aria-label="Autonomous system number"
        />
        <button class="btn btn-secondary" type="submit">Look up</button>
      </form>
      <div id="asnStatus" class="lookup-status" role="status" aria-live="polite"></div>
    </section>

    <section id="asnResult" class="lookup-result" hidden></section>

    <p class="lookup-note muted">
      An ASN is listed when it originates at least one routed <code>/24</code> in the release. Counts are
      <code>/24</code> blocks of the monthly dataset; countries follow the dataset's country scope (the RIR
      unallocated reserve counts for no country). Data source: the current monthly <a href="./downloads.html">release</a>.
    </p>
  </main>

  <div id="asnConfig" data-release={release} data-base={dataBase} hidden></div>

  <style is:inline>
    .lookup { padding: 2.5rem 0 4rem; max-width: 920px; }
    .lookup-hero h1 { margin: 0 0 .5rem; }
    .lookup-sub { color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem; }
    .lookup-form { display: flex; gap: .6rem; padding: .9rem; border-radius: 18px; align-items: center; flex-wrap: wrap; }
    .lookup-input {
      flex: 1 1 320px; min-width: 220px; font: inherit; font-size: 1.05rem;
      padding: .78rem 1rem; border-radius: 12px; border: 1px solid var(--line-strong);
      background: rgba(255,255,255,.045); color: var(--text);
    }
    .lookup-input::placeholder { color: var(--muted); opacity: .7; }
    .lookup-input:focus { outline: none; border-color: var(--accent-2); box-shadow: 0 0 0 3px rgba(45,212,191,.18); }
    .lookup-form .btn { font-size: 1.05rem; padding: .78rem 1.4rem; }
    .lookup-status { margin-top: .8rem; min-height: 1.3rem; font-size: .95rem; color: var(--muted); }
    .lookup-status.err { color: var(--danger); }
    .lookup-result { margin-top: 1.8rem; display: grid; gap: 1rem; }
    .lookup-result[hidden] { display: none; }
    .lk-card { border: 1px solid var(--line); border-radius: 18px; padding: 1.1rem 1.3rem; background: var(--panel); box-shadow: var(--shadow); }
    .lk-card h2 { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); margin: 0 0 .85rem; }
    .lk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem 1.8rem; }
    @media (max-width: 620px) { .lk-grid { grid-template-columns: 1fr; } }
    .lk-row { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: .45rem; }
    .lk-row .k { color: var(--muted); }
    .lk-row .v { font-weight: 500; text-align: right; word-break: break-word; color: var(--text); }
    .lk-head { font-size: 1.6rem; font-weight: 600; color: var(--text); }
    .lk-badge { display: inline-block; font-size: .8rem; font-weight: 600; padding: .15rem .6rem; border-radius: 999px; margin-left: .5rem; vertical-align: middle; background: rgba(79,140,255,.16); color: var(--accent); }
    .lk-badge.warn { background: rgba(251,113,133,.16); color: var(--danger); }
    .lookup-note { margin-top: 2rem; font-size: .9rem; }
    .lk-spin { display:inline-block; width:14px; height:14px; border:2px solid rgba(79,140,255,.3); border-top-color: var(--accent); border-radius:50%; animation: lkspin .7s linear infinite; vertical-align:-2px; margin-right:.5rem; }
    @keyframes lkspin { to { transform: rotate(360deg); } }
    .ak-bars { display: grid; gap: .45rem; }
    .ak-bar { display: grid; grid-template-columns: 170px 1fr 120px; gap: .8rem; align-items: center; }
    @media (max-width: 620px) { .ak-bar { grid-template-columns: 110px 1fr 90px; } }
    .ak-bar .t { height: 8px; border-radius: 999px; background: rgba(255,255,255,.06); overflow: hidden; }
    .ak-bar .t span { display: block; height: 100%; background: var(--accent-2); border-radius: 999px; }
    .ak-bar .n { text-align: right; font-variant-numeric: tabular-nums; }
    .ak-cidrs { display: flex; flex-wrap: wrap; gap: .35rem .5rem; max-height: 320px; overflow: auto; }
    .ak-cidrs a { font: .88rem var(--mono, ui-monospace, monospace); padding: .15rem .5rem; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; }
    .ak-cidrs a:hover { border-color: var(--accent-2); }
  </style>

  <script is:inline type="module">
    const cfg = document.getElementById('asnConfig').dataset;
    const RELEASE = cfg.release;
    const BASE = cfg.base;
    const PREV = (() => {
      const y = Number(RELEASE.slice(0, 4)), m = Number(RELEASE.slice(5, 7));
      return m === 1 ? `${y - 1}-12` : `${y}-${String(m - 1).padStart(2, '0')}`;
    })();

    const form = document.getElementById('asnForm');
    const input = document.getElementById('asnInput');
    const statusEl = document.getElementById('asnStatus');
    const resultEl = document.getElementById('asnResult');
    const shardCache = new Map();

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const flag = (cc) => { const c = String(cc || '').trim().toLowerCase(); return /^[a-z]{2}$/.test(c) ? `<span class="fi fi-${c}" aria-hidden="true"></span> ` : ''; };
    const num = (n) => Number(n || 0).toLocaleString('en-US');
    const pct = (n, d) => d ? `${(100 * n / d).toFixed(1)}%` : '0.0%';
    let regionName = (cc) => cc;
    try { const dn = new Intl.DisplayNames(['en'], { type: 'region' }); regionName = (cc) => (cc ? dn.of(String(cc).toUpperCase()) || cc : cc); } catch (e) { /* keep codes */ }

    function setStatus(msg, isErr) {
      statusEl.innerHTML = msg;
      statusEl.classList.toggle('err', !!isErr);
    }

    // "15169", "AS15169", "as 15169", "AS15169 (Google)" -> 15169
    function toAsn(raw) {
      const m = String(raw || '').trim().match(/^(?:AS\s*)?(\d{1,10})\b/i);
      if (!m) return null;
      const n = Number(m[1]);
      return Number.isInteger(n) && n >= 1 && n <= 4294967295 ? n : null;
    }

    async function loadShard(asn) {
      const k = Math.floor(asn / 1000);
      if (shardCache.has(k)) return shardCache.get(k);
      const res = await fetch(`${BASE}/asn/${RELEASE}/${k}.json`);
      if (res.status === 404 || res.status === 403) { shardCache.set(k, null); return null; }   // no ASN in that range
      if (!res.ok) throw new Error(`fetch ${res.status}`);
      const data = await res.json();
      shardCache.set(k, data.asns || {});
      return shardCache.get(k);
    }

    const row = (k, v) => (v === null || v === undefined || v === '') ? '' :
      `<div class="lk-row"><span class="k">${k}</span><span class="v">${v}</span></div>`;
    const card = (title, inner) => inner ? `<div class="lk-card"><h2>${title}</h2>${inner}</div>` : '';
    const bars = (items, total) => `<div class="ak-bars">${items.map(([label, n]) => `
      <div class="ak-bar"><span>${label}</span><span class="t"><span style="width:${total ? (100 * n / total).toFixed(1) : 0}%"></span></span>
      <span class="n">${num(n)} <span class="muted">${pct(n, total)}</span></span></div>`).join('')}</div>`;

    const RPKI = [['Valid', 'Valid'], ['NotFound', 'No ROA'], ['Unknown', 'Unknown'],
                  ['Invalid-Origin', 'Invalid origin'], ['Invalid-Length', 'Invalid length']];

    function render(r) {
      const site = r.website && /^[a-z0-9.-]+\.[a-z]{2,}$/i.test(r.website)
        ? `<a href="https://${esc(r.website)}" target="_blank" rel="noopener nofollow">${esc(r.website)}</a>` : (r.website ? esc(r.website) : null);
      const head = `<div class="lk-card"><div class="lk-head">${esc(r.label)}${r.name ? ` · ${esc(r.name)}` : ''}
          ${r.type ? `<span class="lk-badge">${esc(r.type)}</span>` : ''}</div>
        <div class="muted" style="margin-top:.2rem">${r.org ? esc(r.org) + ' · ' : ''}Snapshot ${esc(RELEASE)}</div></div>`;

      let since;
      if (!r.prev) since = `<span class="muted">${esc(r.label)} was not active in the ${esc(PREV)} release: it is new in ${esc(RELEASE)}.</span>`;
      else {
        const d = r.prefixes24 - r.prev.prefixes24;
        since = d === 0 ? `<span class="muted">Same number of /24 blocks as in ${esc(PREV)} (${num(r.prefixes24)}).</span>`
          : `<div class="lk-grid">${row('/24 blocks', `${num(r.prev.prefixes24)} → ${num(r.prefixes24)} <span class="muted">(${d > 0 ? '+' : ''}${num(d)})</span>`)}</div>`;
      }

      const identity = `<div class="lk-grid">${[
        row('ASN', esc(r.label)), row('Name', r.name && esc(r.name)), row('Organisation', r.org && esc(r.org)),
        row('Website', site), row('ASN type', r.type && esc(r.type)), row('Network type', r.networkType && esc(r.networkType)),
      ].join('')}</div>`;
      const registry = `<div class="lk-grid">${[
        row('Registered in', r.country && `${flag(r.country)}${esc(regionName(r.country))}`),
        row('RIR', r.rir && esc(String(r.rir).toUpperCase())), row('Allocated', r.allocated && esc(r.allocated)),
        row('Status', r.status && esc(r.status)),
      ].join('')}</div>`;
      const footprint = `<div class="lk-grid">${[
        row('/24 blocks', num(r.prefixes24)), row('IPv4 addresses', num(r.ipv4)),
        row('Routed mainly from', r.routingCountry && `${flag(r.routingCountry)}${esc(regionName(r.routingCountry))}`),
        row('Routing RIR', r.routingRir && esc(String(r.routingRir).toUpperCase())),
        row('CIDR blocks', num(r.cidrCount)),
      ].join('')}</div>`;

      const geoTotal = (r.geo || []).reduce((s, [, n]) => s + n, 0);
      const geo = (r.geo || []).length ? bars(r.geo.map(([cc, n]) => [`${flag(cc)}${esc(regionName(cc))}`, n]), r.prefixes24)
        + (geoTotal < r.prefixes24 ? `<p class="muted" style="margin:.6rem 0 0">${num(r.prefixes24 - geoTotal)} /24s are elsewhere or have no country.</p>` : '')
        : '<span class="muted">None of its /24 blocks has a country in this release.</span>';

      const rpkiItems = RPKI.filter(([k]) => r.rpki && r.rpki[k]).map(([k, label]) => [label, r.rpki[k]]);
      const security = (rpkiItems.length ? bars(rpkiItems, r.prefixes24) : '') +
        `<div class="lk-grid" style="margin-top:.8rem">${row('Possible BGP hijack /24s',
          r.hijack24 ? `<span class="lk-badge warn">${num(r.hijack24)}</span>` : '0')}</div>`;

      const risk = `<div class="lk-grid">${[
        row('Cloud provider', r.cloud ? `${esc(r.cloud)} <span class="muted">(${num(r.cloud24)} /24s)</span>` : (r.cloud24 ? `${num(r.cloud24)} /24s` : 'No')),
        row('Tor /24s', num(r.tor24)), row('VPN /24s', num(r.vpn24)),
        row('C2 hosting /24s', r.c2_24 ? `<span class="lk-badge warn">${num(r.c2_24)}</span>` : '0'),
        row('Threat-listed /24s', r.threat24 ? `<span class="lk-badge warn">${num(r.threat24)}</span>` : '0'),
        row('Abuse contact', r.abuse ? esc(r.abuse) : '<span class="muted">not one for most of its blocks</span>'),
      ].join('')}</div>`;

      const shown = (r.cidrs || []).length;
      const prefixes = shown ? `<div class="ak-cidrs">${r.cidrs.map((c) =>
          `<a href="prefix-lookup.html?q=${encodeURIComponent(c.split('/')[0])}" title="Open ${esc(c)} in Prefix lookup">${esc(c)}</a>`).join('')}</div>`
        + (r.cidrCount > shown ? `<p class="muted" style="margin:.7rem 0 0">Showing the first ${num(shown)} of ${num(r.cidrCount)} blocks. The full list is in the monthly packages.</p>` : '')
        : '';

      resultEl.innerHTML = head + card(`Since ${esc(PREV)}`, since) + card('Identity', identity) + card('Registry', registry)
        + card('Routed footprint', footprint) + card('Where its /24s geolocate', geo) + card('Routing security (RPKI)', security)
        + card('Risk signals & services', risk) + card('Prefixes', prefixes);
      resultEl.hidden = false;
    }

    async function doLookup(e) {
      if (e) e.preventDefault();
      resultEl.hidden = true;
      const asn = toAsn(input.value);
      if (!asn) { setStatus('Enter an AS number, for example 15169 or AS13335.', true); return; }
      setStatus(`<span class="lk-spin"></span>Looking up AS${asn} …`);
      try {
        const shard = await loadShard(asn);
        const r = shard ? shard[String(asn)] : null;
        if (!r) { setStatus(`No record for AS${asn}: it originates no routed /24 in the ${esc(RELEASE)} release.`); return; }
        setStatus(`Result for AS${asn}`);
        render(r);
        const url = new URL(location.href);
        url.searchParams.set('asn', String(asn));
        history.replaceState(null, '', url);
      } catch (err) {
        setStatus(`Lookup failed: ${esc(err.message || err)}. The data may not be published yet.`, true);
      }
    }

    form.addEventListener('submit', doLookup);
    // Deep link support: /asn-lookup.html?asn=15169
    const q = new URLSearchParams(location.search).get('asn');
    if (q) { input.value = q; doLookup(); }
  </script>
</BaseLayout>
